{
  "$schema": "../gen/schemas/android-schema.json",
  "identifier": "android-main",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-remove",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*/*" }, { "url": "https://*/*" }]
    }
  ]
}
